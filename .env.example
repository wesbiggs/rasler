# Required: this node's public origin (protocol + host, no trailing slash).
# Used in Link: rel="duplicate" headers. Include the port if non-standard.
# Example for local dev: http://localhost:3000
ORIGIN=https://node1.example.com

# HTTP listen port (default: 3000)
PORT=3000

# Directory for SQLite database and content blobs (default: ./data)
DATA_DIR=./data

# Total storage capacity for DATA_DIR: pinned and unpinned content (default: 1G = 1 GiB).
# Accepts human-friendly units: 200M, 1G, 2GB, 500K, 1TB, or a plain byte count.
TOTAL_CAPACITY=1G

# Required: pre-shared secret for the Operator API (x-rasl-operator-secret header)
API_SECRET=change-me-to-a-strong-random-secret

# Mount the Operator API (and Swagger UI, if enabled) under this URL path prefix
# instead of the root. Example: /admin → /admin/upload, /admin/status, /admin/api-docs.
# Public RASL endpoints (/.well-known/rasl/*) and virtual hosts are unaffected.
OPERATOR_API_PATH_PREFIX=

# Set to true to serve Swagger UI at /api-docs (default: false).
# Use the Authorize button in the UI to set x-rasl-operator-secret for live requests.
SWAGGER_UI=false

# Allowed origins for the Operator API (CORS). Comma-separated list of origins, or * to allow all.
# Leave unset to disable CORS (default). Example: http://localhost:5173,https://admin.example.com
OPERATOR_CORS_ORIGINS=

# Comma-separated absolute directory paths to serve as static RASL roots (no upload needed).
# Example: /var/www/html,/var/www/assets
STATIC_ROOTS=

# Maximum number of pinned MASL versions per static root (older versions become eligible for LRU eviction).
# Leave unset for unlimited history.
STATIC_MAX_HISTORY=

# Comma-separated mount point definitions. Each entry maps a hostname with an
# optional URL path prefix to a local directory. The directory is automatically
# added to STATIC_ROOTS. More specific (longer) prefixes take priority.
# Example: example.com:/var/www/html,example.com/docs:/var/www/docs,docs.example.com:/var/www/docs
MOUNT_POINTS=
